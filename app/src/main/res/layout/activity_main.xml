<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1020"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="20dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="COLOR PUZZLE"
        android:textColor="#F5F7FF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="ДУМАЙ. НАХОДИ ПУТЬ. УБИРАЙ БЛОКИ."
        android:textColor="#8996B5"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/panel_bg"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/levelCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ТЕКУЩИЙ УРОВЕНЬ"
                android:textColor="#8996B5"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Уровень 1"
                android:textColor="#F5F7FF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:background="#2A3550" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/livesCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ЖИЗНИ"
                android:textColor="#8996B5"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLives"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="❤️❤️❤️"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="УБИРАЙ СТРЕЛКИ, КОТОРЫМ НИЧТО НЕ МЕШАЕТ"
        android:textColor="#A8B4D0"
        android:textSize="10sp"
        android:textStyle="bold" />

    <com.example.colorpuzzle.ColorPuzzleView
        android:id="@+id/puzzleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Игровое поле с цветными блоками и стрелками"
        android:importantForAccessibility="yes" />

    <Button
        android:id="@+id/btnRestart"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="↻   Повторить уровень"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/restart_button_bg"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="⚙   Настройки"
        android:textAllCaps="false"
        android:textColor="#DDE4FF"
        android:textSize="14sp"
        android:backgroundTint="#202B45"
        android:stateListAnimator="@null" />

</LinearLayout>
